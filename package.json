{
  "name": "vic-ui",
  "version": "0.1.0",
  "description": "A quiet, dense React 19 component library: an oklch palette in light and dark, one corner scale, one elevation scale, and pieces whose state never changes their size.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "licenses",
    "MAP.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./styles.css": "./dist/vic-ui.css",
    "./components.css": "./dist/components.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json",
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui.js"
    },
    "./ui/styles.css": "./dist/ui/styles.css"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:css",
    "build:lib": "vite build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:css": "node scripts/build-css.mjs && tailwindcss -i src/ui/styles.css -o dist/ui/styles.css --minify",
    "build:site": "npm run build:website",
    "dev:site": "npm run dev:website",
    "preview:site": "cd website && vite preview --outDir build/client",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:design": "node scripts/check-radius.mjs && node scripts/check-shadows.mjs && node scripts/check-fills.mjs",
    "check:dashes": "node scripts/check-dashes.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "prepublishOnly": "npm run typecheck && npm run check:design && npm run check:dashes && npm run build",
    "prepare": "npm run build",
    "test": "npm run build && node --test tests/button.test.mjs tests/accent-button.test.mjs tests/sidebar.test.mjs tests/catalogue.test.mjs tests/recipes.test.mjs",
    "dev:website": "cd website && react-router dev",
    "build:website": "cd website && react-router build",
    "typecheck:website": "cd website && react-router typegen && tsc --noEmit -p tsconfig.json",
    "test:review": "node --test tests/review.test.mjs",
    "test:website": "npm run build:website && node --test tests/website.test.mjs",
    "build:reference-site": "vite build --config site/vite.config.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@floating-ui/dom": "^1.8.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "isbot": "^5",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.18.0",
    "recharts": "^3.8.0",
    "shiki": "^4.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@iconify-json/mingcute": "^1.2.8",
    "@iconify-json/tabler": "^1.2.38",
    "@react-router/dev": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@tailwindcss/cli": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "agentation": "^3.1.2",
    "fumadocs-core": "^16.17.10",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.17.10",
    "next-themes": "^0.4.6",
    "playwright": "^1.64.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.4",
    "tsc-alias": "^1.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "oklch",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerynv/vic-ui.git"
  },
  "homepage": "https://jerynv.github.io/vic-ui/"
}
