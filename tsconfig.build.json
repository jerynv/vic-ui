{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": []
  },
  "include": ["src"],
  "tsc-alias": {
    "replacers": {
      "declarationPaths": { "enabled": true, "file": "./scripts/declaration-paths.cjs" }
    }
  }
}
